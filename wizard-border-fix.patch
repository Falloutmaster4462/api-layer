+/* Give the wizard's text input fields a visible border so they're distinguishable
+   from surrounding labels/descriptive text (#4752). Scoped to .wizardFormFields so
+   Select (.formField) and Checkbox inputs, which already look interactive, are untouched. */
+.wizardFormFields .MuiInput-underline {
+    border: 1px solid #ccc;
+    border-radius: 0.1875em;
+    padding: 4px 8px;
+}
+
+.wizardFormFields .MuiInput-underline:before,
+.wizardFormFields .MuiInput-underline:after {
+    border-bottom: none;
+    content: none;
+}
+
+.wizardFormFields .MuiInput-underline.Mui-focused {
+    border-color: #3272d9;
+    box-shadow: 0 0 0 2px rgba(50, 114, 217, 0.2);
+}
+
+.wizardFormFields .MuiInput-underline.Mui-disabled {
+    border-color: #e0e0e0;
+    background-color: #f5f5f5;
+}
+
+.wizardFormFields .MuiInput-underline.Mui-error {
+    border-color: #d32f2f;
+}
